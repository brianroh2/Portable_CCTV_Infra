# ── Frigate 민감 정보 ──────────────────────────
frigate/config/.jwt_secret
frigate/config/notifications.pem
frigate/config/.exports

# ── Frigate DB / 런타임 파일 ───────────────────
frigate/config/frigate.db
frigate/config/frigate.db-shm
frigate/config/frigate.db-wal
frigate/config/backup.db
frigate/config/.search_stats.json
frigate/config/.timeline
frigate/config/.vacuum

# ── Frigate 대용량 파일 ────────────────────────
frigate/config/model_cache/
frigate/storage/

# ── Thingsboard 데이터 ─────────────────────────
thingsboard/data/

# ── 로그 파일 ──────────────────────────────────
**/*.log

# ── Claude 설정 ────────────────────────────────
**/.claude/
# 프로젝트 공유 대상: hooks + 프로젝트 settings
!.claude/
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/*.py
.claude/settings.local.json
# ── 가상환경 ───────────────────────────────────
thingsboard/.venv/
# ── 임시 작업 폴더 ─────────────────────────────
temp/
# ── Frontend 빌드/의존성 ───────────────────────
app/frontend/node_modules/
app/frontend/.next/
# ── 환경변수 (민감정보) ────────────────────────
app/frontend/.env.local
